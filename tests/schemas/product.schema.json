{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/product.schema.json",
  "title": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 10,
      "minLength": 4
    },
    "price": {
      "type": "number",
      "maximum": 100,
      "multipleOf": 2,
      "minimum": 0
    }
  },
  "additionalProperties": true,
  "required": [
    "name",
    "price"
  ]
}
